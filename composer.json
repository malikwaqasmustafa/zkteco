{
    "name": "maliklibs/zkteco",
    "description": "ZKTeco Laravel Library - Compatible with Laravel 6, 8, 9, 10",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "zkteco", "attendance", "biometric", "fingerprint"],
    "authors": [
        {
            "name": "Malik Waqas",
            "email": "malik.waqas.09@hotmail.com"
        }
    ],
    "require": {
        "php": "^7.4|^8.0|^8.1|^8.2",
        "illuminate/support": "^6.0|^8.0|^9.0|^10.0|^11.0",
        "ext-mbstring": "*",
        "ext-sockets": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^4.0|^6.0|^7.0|^8.0",
        "phpunit/phpunit": "^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "maliklibs\\Zkteco\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "maliklibs\\Zkteco\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "maliklibs\\Zkteco\\Providers\\ZktecoServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
